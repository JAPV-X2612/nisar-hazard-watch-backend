# Copy to .env for local runs. Never commit real secrets.
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nisar_hazard_watch
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional: only needed by features that read NASA data or call Modal.
# EARTHDATA_TOKEN=
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
